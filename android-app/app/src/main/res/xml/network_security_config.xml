<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS-only baseline. Certificate pins are intentionally added per production host. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
